# ============================================================
# TWOK STUDIO — Environment variables
# Copy to `.env` (local) or set in Vercel / server dashboard.
# Never commit the real `.env`.
# ============================================================

# --- Database (PostgreSQL) -----------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/twok_studio"

# --- App ------------------------------------------------------
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Minimum 32 characters — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# --- Seed admin (used by `npm run db:seed`) -------------------
SEED_ADMIN_EMAIL="admin@twokstudio.local"
SEED_ADMIN_PASSWORD="ChangeMe-TWOK-2026"
SEED_ADMIN_NAME="Administrateur"

# --- Media storage -------------------------------------------
# local | s3
MEDIA_DRIVER="local"
UPLOAD_DIR="./public/uploads"
PUBLIC_UPLOAD_URL="/uploads"
MAX_UPLOAD_MB="512"
# S3 (only when MEDIA_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"

# --- SMTP (optional) -----------------------------------------
# Leave empty to disable email. Notifications are recorded as
# SKIPPED, never as fake success.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_NOTIFICATION_EMAIL=""

# --- WhatsApp Cloud API (optional) ---------------------------
WHATSAPP_API_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v23.0"

# --- Backups -------------------------------------------------
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
